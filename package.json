{
  "name": "harness-memory-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Memory, knowledge, skills and scoped capability orchestration for a compatible Harness host.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare:host": "node scripts/apply-host-compat.mjs",
    "build": "npm run build --workspace=dsh-fileman",
    "test:memory": "npm test --workspace=dsh-mnemo",
    "test:knowledge": "npm test --workspace=@local/knowledge-vault",
    "test:files": "npm test --workspace=dsh-fileman",
    "test:policy": "npm test --workspace=dsh-context-policy",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "npm run test:memory && npm run test:knowledge && npm run test:files && npm run test:policy",
    "verify": "npm run check:privacy && npm run check:syntax && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "acorn": "8.15.0",
    "acorn-jsx": "5.3.2",
    "esbuild": "0.25.12",
    "yaml": "2.8.1",
    "zod": "4.6.1"
  }
}
