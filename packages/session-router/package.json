{
  "name": "@local/cross-session-agent-router",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Durable ordinary-session creation and cross-session relay",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "zod": "^4.3.6"
  }
}
